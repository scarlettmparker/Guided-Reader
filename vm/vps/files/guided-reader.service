[Unit]
Description=Guided Reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/guided-reader
Environment=NODE_ENV=production
Environment=SERVER_PORT=5178
ExecStart=/usr/local/bin/bun --preload ./css-plugin.ts server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
