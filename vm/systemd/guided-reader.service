[Unit]
Description= Guided Reader (Fastify SSR)
After=network.target sun-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/guided-reader
ExecStart=/usr/bin/npx tsx --loader ./css-loader.mjs server.js
Environment=NODE_ENV=production
EnvironmentFile=/opt/guided-reader/port
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
