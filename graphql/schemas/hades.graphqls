type ReaderSource {
  id: String!
  name: String!
  url: String!
}

type ReaderText {
  id: String!
  title: String!
  content: String!
  language: String!
  level: CefrLevel!
  ownerId: ID
  sourceId: ID
  status: ReaderTextStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

type ReaderPosition {
  id: String!
  textId: ID!
  startOffset: Int!
  endOffset: Int!
}

type ReaderAnnotation {
  id: String!
  positionId: ID!
  position: ReaderPosition
  body: String!
  status: ReaderStatus!
  upvotes: Int!
  downvotes: Int!
  netScore: Int!
  replyCount: Int!
  remoteObject: [String!]
  author: RemoteUser
  authorProfile: ReaderAccount
  myVote: VoteValue
  createdAt: DateTime
  updatedAt: DateTime
}

type PagedReaderAnnotations {
  items: [ReaderAnnotation!]!
  pageInfo: PageInfo!
}

type ReaderComment {
  id: String!
  annotationId: ID!
  parentId: ID
  body: String!
  status: ReaderStatus!
  upvotes: Int!
  downvotes: Int!
  netScore: Int!
  author: RemoteUser
  authorProfile: ReaderAccount
  myVote: VoteValue
  createdAt: DateTime
  updatedAt: DateTime
}

type ReaderAccount {
  id: String!
  gaiaAccountId: ID!
  discordId: String!
  discordUsername: String
  globalName: String
  avatar: String
  cefrLevel: CefrLevel
  roles: [ReaderRole!]!
}

type ReaderRole {
  key: String!
  name: String!
  cefrLevel: CefrLevel
}

type LevelProbability {
  level: CefrLevel!
  probability: Float!
}

type ComplexityFactor {
  name: String!
  value: Float!
  direction: String!
  weight: Float!
}

type TextLevelAssessment {
  level: CefrLevel!
  confidence: Float!
  probabilities: [LevelProbability!]!
  factors: [ComplexityFactor!]!
}

enum WordScope {
  ALL_TRANSLATIONS
  EXAMPLES
  COMPOUNDS
  RELATED_WORDS
}

type Word {
  id: ID!
  term: String!
  wordType: String
  entries: [WordEntry!]!
  compounds: [WordEntry!]!
  relatedWords: [Word!]!
  sourceUrl: String!
}

type WordEntry {
  id: ID!
  term: String!
  wordType: String!
  sense: String
  translations: [WordTranslation!]!
  examples: [String!]!
  note: String
}

type WordTranslation {
  term: String!
  wordType: String
  usageNotes: [String!]!
}

type PrivateNote {
  id: String!
  textId: ID!
  startOffset: Int!
  endOffset: Int!
  body: String!
  visibility: PrivateNoteVisibility!
  remoteObject: [String!]
  author: RemoteUser
  authorProfile: ReaderAccount
  createdAt: DateTime
  updatedAt: DateTime
}

enum PrivateNoteVisibility {
  PRIVATE
  SHARED
}

type PagedPrivateNotes {
  items: [PrivateNote!]!
  pageInfo: PageInfo!
}

input PrivateNoteInput {
  textId: ID!
  startOffset: Int!
  endOffset: Int!
  body: String!
}

input ShareInput {
  objectType: String!
  objectId: ID!
  subjectType: String!
  subjectId: ID!
  relation: String!
}

input ShareNotesInput {
  textId: ID!
  subjectIds: [ID!]
  subjectEmails: [String!]
}

type PagedReaderTexts {
  items: [ReaderText!]!
  pageInfo: PageInfo!
}

type PagedReaderComments {
  items: [ReaderComment!]!
  pageInfo: PageInfo!
}

type DiscordLoginResult {
  token: String!
  accountId: ID!
  readerAccountId: ID!
  requiresReactivation: Boolean!
}

type ReaderObjectReference {
  id: ID!
  ownerType: String!
  ownerId: ID!
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}
enum ReaderTextStatus {
  ACTIVE
  ARCHIVED
}
enum ReaderStatus {
  ACTIVE
  HIDDEN
}
enum ReaderVoteTarget {
  ANNOTATION
  COMMENT
}

input ReaderTextInput {
  title: String!
  content: String!
  language: String!
  level: CefrLevel!
  ownerId: ID
  sourceId: ID
}

input AnnotationInput {
  textId: ID!
  startOffset: Int!
  endOffset: Int!
  body: String!
}

input CommentInput {
  annotationId: ID!
  parentId: ID
  body: String!
}

input VoteInput {
  targetType: ReaderVoteTarget!
  targetId: ID!
  value: VoteValue!
}

type TextView {
  textId: ID!
  viewedAt: DateTime!
}

type PagedTextViews {
  items: [TextView!]!
  pageInfo: PageInfo!
}

type HadesQueries {
  text(id: ID!): ReaderText
  source(id: ID!): ReaderSource
  sources: [ReaderSource!]
  texts(pagination: PaginationInput): PagedReaderTexts!
  classifyTextLevel(text: String!): TextLevelAssessment
  annotations(
    textId: ID!
    includeHidden: Boolean
    pagination: PaginationInput
  ): PagedReaderAnnotations!
  annotation(id: ID!): ReaderAnnotation
  comments(
    annotationId: ID!
    includeHidden: Boolean
    pagination: PaginationInput
  ): PagedReaderComments!
  privateNotes(textId: ID!, pagination: PaginationInput): PagedPrivateNotes!
  readerAccount: ReaderAccount
  readerAccounts(remoteUsers: [RemoteUserInput!]!): [ReaderAccount!]!
  searchReaderAccounts(query: String!, pagination: PaginationInput): [ReaderAccount!]!
  myVote(targetType: ReaderVoteTarget!, targetId: ID!): VoteValue
  locateRemoteObjects(ids: [String!]!): [ReaderObjectReference!]!
   defineWord(word: String!, scope: [WordScope!]): Word
   viewedTexts(pagination: PaginationInput): PagedTextViews!
   viewedReaderTexts(pagination: PaginationInput): PagedReaderTexts!
}

type HadesMutations {
  createSource(name: String!, url: String!): QueryResult
  createText(input: ReaderTextInput!): QueryResult
  archiveText(id: ID!): QueryResult
  markViewed(textId: ID!): QueryResult
  createAnnotation(input: AnnotationInput!): QueryResult
  editAnnotation(id: ID!, body: String!): QueryResult
  deleteAnnotation(id: ID!): QueryResult
  addComment(input: CommentInput!): QueryResult
  editComment(id: ID!, body: String!): QueryResult
  deleteComment(id: ID!): QueryResult
  vote(input: VoteInput!): QueryResult
  removeVote(targetType: ReaderVoteTarget!, targetId: ID!): QueryResult
  createPrivateNote(input: PrivateNoteInput!): QueryResult
  deletePrivateNote(id: ID!): QueryResult
  shareNotes(input: ShareNotesInput!): QueryResult
  attachObject(source: ID!, target: String!): QueryResult
  discordLogin(code: String!, state: String!): DiscordLoginResult
}

extend type Query {
  hadesQueries: HadesQueries!
}

extend type Mutation {
  hadesMutations: HadesMutations!
}
