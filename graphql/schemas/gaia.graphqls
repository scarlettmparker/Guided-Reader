scalar JSON

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

type Role {
  id: ID!
  name: String!
  description: String
  createdAt: DateTime
  updatedAt: DateTime
}

type PropertySetEntry {
  id: String!
  ownerKey: String!
  propertySet: String!
  entryName: String!
  values: JSON!
  configurable: Boolean!
  status: String!
  createdAt: DateTime
  updatedAt: DateTime
}

type PropertySetSchema {
  id: String!
  ownerKey: String
  name: String!
  properties: JSON!
  configurable: Boolean!
  status: String!
  createdAt: DateTime
  updatedAt: DateTime
}

input PropertySetSchemaInput {
  ownerKey: String
  name: String!
  configurable: Boolean
  properties: JSON!
}

input UpsertPropertyEntryInput {
  values: JSON!
}

input SetPropertyInput {
  property: String!
  value: JSON!
}

type GaiaQueries {
  me: Account
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  propertySets(ownerKey: String!, name: String!): [PropertySetEntry!]!
  propertySetSchemas(ownerKey: String): [PropertySetSchema!]!
  propertySetSchema(ownerKey: String!, name: String!): PropertySetSchema
  myRoles: [String!]!
  account(id: ID!): Account
  accounts(pagination: PaginationInput): PagedAccounts!
  roles: [Role!]!
  role(id: ID!): Role
  accountRoles(accountId: ID!): [String!]!
  accountPermissions(accountId: ID!): [String!]!
  rolePermissions(roleId: ID!): [String!]!
  allPermissions: [String!]!
}

input LoginInput {
  username: String!
  password: String!
}

type AuthResult {
  token: String!
  accountId: ID!
  personId: ID!
}

type LogoutResponse {
  message: String!
}

type SuspendAccountResponse {
  message: String!
  account: Account!
}

type UnsuspendAccountResponse {
  message: String!
  account: Account!
}

type CreateRoleResponse {
  message: String!
  role: Role!
}

type DeleteRoleResponse {
  message: String!
  id: ID!
}

type SetAccountRolesResponse {
  message: String!
  accountId: ID!
  roles: [String!]!
}

type SetAccountPermissionsResponse {
  message: String!
  accountId: ID!
  permissions: [String!]!
}

type SetRolePermissionsResponse {
  message: String!
  roleId: ID!
  permissions: [String!]!
}

type DeactivateAccountResponse {
  message: String!
}

type RequestAccountReactivationResponse {
  message: String!
}

type ConfirmAccountReactivationResponse {
  message: String!
}

type UpsertPropertyEntryResponse {
  message: String!
  entry: PropertySetEntry!
}

type SetPropertyResponse {
  message: String!
  entry: PropertySetEntry!
}

type RegisterPropertySetSchemaResponse {
  message: String!
  schema: PropertySetSchema!
}

type DeletePropertyEntryResponse {
  message: String!
  id: ID!
}

type GaiaMutations {
  login(input: LoginInput!): AuthResult
  logout: LogoutResponse!
  suspendAccount(id: ID!): SuspendAccountResponse!
  unsuspendAccount(id: ID!): UnsuspendAccountResponse!
  createRole(name: String!, description: String): CreateRoleResponse!
  deleteRole(id: ID!): DeleteRoleResponse!
  setAccountRoles(accountId: ID!, roleNames: [String!]!): SetAccountRolesResponse!
  setAccountPermissions(accountId: ID!, permissions: [String!]!): SetAccountPermissionsResponse!
  setRolePermissions(roleId: ID!, permissions: [String!]!): SetRolePermissionsResponse!
  deactivateAccount: DeactivateAccountResponse!
  requestAccountReactivation(email: String!, provider: String!): RequestAccountReactivationResponse!
  confirmAccountReactivation(token: String!): ConfirmAccountReactivationResponse!
  upsertPropertyEntry(
    ownerKey: String!
    name: String!
    entry: String!
    input: UpsertPropertyEntryInput!
  ): UpsertPropertyEntryResponse!
  setProperty(
    ownerKey: String!
    name: String!
    entry: String!
    input: SetPropertyInput!
  ): SetPropertyResponse!
  registerPropertySetSchema(input: PropertySetSchemaInput!): RegisterPropertySetSchemaResponse!
  deletePropertyEntry(ownerKey: String!, name: String!, entry: String!): DeletePropertyEntryResponse!
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}
